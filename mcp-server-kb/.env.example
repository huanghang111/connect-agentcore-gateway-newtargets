# Copy this file to `.env` and fill in your values BEFORE running ./deploy.sh
#   cp .env.example .env
# `.env` is gitignored — never commit it.
#
# NOTE: this file configures ./deploy.sh (region + Gateway inbound auth). It is
# separate from `agentcore/.env.local`, which is the AgentCore CLI's own file
# for runtime SECRETS (non-Bedrock API keys, payment credentials) — leave that
# one alone unless you add such a provider.

# ============================================================
# 必填 REQUIRED
# ============================================================

# AWS region（Runtime / Gateway / KB / DynamoDB 都部署到这里）
REGION=us-east-1

# ============================================================
# 可选 OPTIONAL — Gateway 入站鉴权
# ============================================================

# 留空 = Gateway 用 NONE（免鉴权），首次 PoC 最省事。
#   ⚠️ 免鉴权意味着任何人拿到 Gateway MCP endpoint 都能调用，仅建议 PoC/内网。
# 填了 = Gateway 用 CUSTOM_JWT，值为 Connect 实例 OIDC discovery URL，形如：
#   https://<你的实例域名>.my.connect.aws/.well-known/openid-configuration
# deploy.sh 会自动做两遍部署，把 allowedAudience 设为新 Gateway 自身 ID
# （即 Connect JWT 的 aud claim）。
OIDC_DISCOVERY_URL=

# 可选：限制被接受的 OAuth client id（逗号分隔）。一般留空。
OIDC_ALLOWED_CLIENTS=
