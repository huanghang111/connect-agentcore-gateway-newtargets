# Copy to `.env` and tweak. `.env` is gitignored — never commit it.
# On a fresh clone you usually only need to set REGION; the rest auto-fills.

# AWS
REGION=us-east-1
# Leave empty to let the script resolve it via `aws sts get-caller-identity`.
ACCOUNT_ID=

# Backend API (CloudFormation stack)
STACK_NAME=connect-repair-api-stack
# Leave empty to default to connect-repair-api-${ACCOUNT_ID}-${REGION}.
BUCKET_NAME=

# MCP Agent naming (resource names — leave as-is unless you want a fresh set)
AGENT_NAME=connect-repair-mcp-server
ECR_REPO_NAME=connect-repair-mcp-server
TARGET_NAME=connect-repair-mcp-agent

# AgentCore Gateway
# Leave GATEWAY_ID empty to let deploy.sh auto-create one with
# authorizerType=NONE (open inbound — TESTING only; anyone with the MCP URL
# can call your tools). Production deployments should reuse an existing
# Gateway configured with CUSTOM_JWT or AWS_IAM and set both GATEWAY_ID and
# GATEWAY_SERVICE_ROLE here.
GATEWAY_ID=
GATEWAY_SERVICE_ROLE=

# Backend Repair API endpoint — auto-populated by deploy.sh from the
# CloudFormation stack outputs. Leave empty on a fresh clone.
REPAIR_API_URL=
REPAIR_API_KEY=

# Identity token signing key — HMAC secret the MCP server uses to sign /
# verify the short-lived `customerId` tokens issued by verifyCustomer.
# Leave EMPTY on first run — deploy.sh runs `openssl rand -hex 32` once and
# writes the value back here so every subsequent deploy reuses the SAME
# secret (regenerating on every deploy would invalidate every in-flight
# customer's token). To rotate: empty this line and re-run deploy.sh.
IDENTITY_TOKEN_SECRET=
# IDENTITY_TOKEN_TTL_S=3600

# Response normalization (optional — defaults are baked into mcp_server.py).
# Set NORMALIZE_RESPONSE=0 to disable LLM-based normalization.
# NORMALIZE_RESPONSE=1
# NORMALIZE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=us-east-1
# NORMALIZE_TIMEOUT_S=4
