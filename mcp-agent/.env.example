# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit it.

# AWS
REGION=us-east-1
ACCOUNT_ID=123456789012

# Naming (can usually leave as-is)
AGENT_NAME=midea-repair-mcp-server
ECR_REPO_NAME=midea-repair-mcp-server
TARGET_NAME=midea-repair-mcp-agent

# AgentCore Gateway (must already exist)
GATEWAY_ID=your-gateway-id-xxxxxxxx
GATEWAY_SERVICE_ROLE=AmazonBedrockAgentCoreGatewayDefaultServiceRole...

# Backend Repair API
REPAIR_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
REPAIR_API_KEY=your-api-key-here
