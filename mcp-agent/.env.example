# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit it.

# AWS
REGION=us-east-1
# ACCOUNT_ID is optional — leave commented to let the script resolve it
# automatically via `aws sts get-caller-identity` (recommended on CloudShell).
# ACCOUNT_ID=123456789012

# Naming (can usually leave as-is)
AGENT_NAME=connect-repair-mcp-server
ECR_REPO_NAME=connect-repair-mcp-server
TARGET_NAME=connect-repair-mcp-agent

# AgentCore Gateway
# Leave GATEWAY_ID empty to let the deploy script create one named "${AGENT_NAME}-gateway".
# Leave GATEWAY_SERVICE_ROLE empty to auto-create a default service role.
GATEWAY_ID=
GATEWAY_SERVICE_ROLE=
# When auto-creating a Gateway, JWT authorizer config is required.
# Only GATEWAY_JWT_DISCOVERY_URL is mandatory — the script automatically sets
# allowedAudience = the new Gateway's own ID (which is what Connect's JWT carries).
# Use ALLOWED_AUDIENCE / ALLOWED_CLIENTS only to ADD extra audiences/clients on top.
# Ignored if GATEWAY_ID is already set.
GATEWAY_JWT_DISCOVERY_URL=
GATEWAY_JWT_ALLOWED_AUDIENCE=
GATEWAY_JWT_ALLOWED_CLIENTS=

# Backend Repair API
REPAIR_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
REPAIR_API_KEY=your-api-key-here

# Identity token signing (server-side hard enforcement of Flow 1 / Flow 2).
# REQUIRED in production: a >=32-byte random hex string used as the HMAC key
# for the short-lived `customerId` tokens that verifyCustomer /
# verifyCustomerByPhoneAndName return and that requestRepair / trackRepair /
# cancelRepair validate.
#
# Leave EMPTY on first run — `deploy.sh` will run `openssl rand -hex 32` once
# and write the generated value back here, so subsequent deploys reuse the
# SAME secret (a fresh secret on every deploy would invalidate every in-flight
# customer's token). Do NOT put `$(openssl rand -hex 32)` literally — `deploy.sh`
# does `source .env`, so a literal subshell would re-roll the secret each run.
# To rotate: empty this line, run deploy.sh once, all live tokens get
# invalidated and the new secret is persisted.
IDENTITY_TOKEN_SECRET=
# Token TTL in seconds (default 3600 = 60 minutes — covers a typical call
# without leaving long-lived authority). Lower = tighter security, more
# re-verifications. Optional.
# IDENTITY_TOKEN_TTL_S=3600

# Response normalization (trackRepair / cancelRepair).
# All four are OPTIONAL — uncomment to override the defaults baked into mcp_server.py.
# Set NORMALIZE_RESPONSE=0 to disable LLM-based normalization entirely
# (tools will return the raw upstream JSON unchanged).
# NORMALIZE_RESPONSE=1
# NORMALIZE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=us-east-1
# NORMALIZE_TIMEOUT_S=4
