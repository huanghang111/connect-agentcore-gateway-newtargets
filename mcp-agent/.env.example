# Copy this file to `.env` and fill in your values BEFORE running ./deploy.sh
#   cp .env.example .env
# `.env` is gitignored — never commit it.

# ============================================================
# 必填 REQUIRED — 部署前必须填写，否则 deploy.sh 会直接报错退出
# ============================================================

# AWS region (同 Backend API 的 region)
REGION=us-east-1

# --- 来自第 1 步 Backend API 的 deployment-info.log ---
REPAIR_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
REPAIR_API_KEY=your-api-key-here

# --- 来自 Amazon Connect 实例 (Inbound JWT 鉴权) ---
# Connect 实例的 OIDC discovery URL，形如：
#   https://<你的实例域名>.my.connect.aws/.well-known/openid-configuration
# GATEWAY_ID 留空时（自动创建 Gateway）此项必填。
GATEWAY_JWT_DISCOVERY_URL=

# ============================================================
# 可选 OPTIONAL — 一般保持默认即可，无需改动
# ============================================================

# 资源命名
AGENT_NAME=connect-repair-mcp-server
ECR_REPO_NAME=connect-repair-mcp-server
TARGET_NAME=connect-repair-mcp-agent

# Gateway 复用模式：填 GATEWAY_ID 则复用现有 Gateway（同时必须填 GATEWAY_SERVICE_ROLE 角色名）。
# 两者都留空 = 自动创建一个名为 "${AGENT_NAME}-gw" 的 Gateway。
GATEWAY_ID=
GATEWAY_SERVICE_ROLE=

# 自动创建 Gateway 时，脚本会自动把 allowedAudience 设为新 Gateway 自己的 ID
# （即 Connect JWT 中的 aud claim）。仅当需要额外叠加 audience/client 时才填下面两项。
GATEWAY_JWT_ALLOWED_AUDIENCE=
GATEWAY_JWT_ALLOWED_CLIENTS=

# 身份令牌签名密钥（verifyCustomer 流程用）。留空即可 —— deploy.sh 首次运行会
# 自动执行 openssl rand -hex 32 生成并写回本文件，后续部署复用同一密钥。
IDENTITY_TOKEN_SECRET=
